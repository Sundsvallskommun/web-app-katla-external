          "city"
        ],
        "gap": "gap-24"
      }
    ]
  },
  "invoiceReference": {
    "ui:widget": "TexteditorWidget",
    "ui:options": {
      "className": "w-full min-h-[14rem]"
    },
    "ui:description": "<p>Ange här om du vill att fakturan ska ha någon specifik märkning, exempelvis ett namn eller nummer.</p>"
  },
  "businessDescriptionChoice": {
    "ui:widget": "RadiobuttonWidget",
    "ui:description": "<p>Du måste lämna en detaljerad beskrivning av företagets verksamhet.</p>\n\n<p>Om du väljer att bifoga en fil bifogar du den under Bilagor längst ner i formuläret.</p>\n\n<p><strong>Hur vill du lämna verksamhetsbeskrivningen?</strong></p>"
  },
  "businessDescription": {
    "ui:widget": "TexteditorWidget",
    "ui:options": {
      "className": "w-full min-h-[24rem]"
    }
  },
  "knowledgeOfAlcoholAct": {
    "ui:widget": "RadiobuttonWidget",
    "ui:description": "<p>För att få ett serveringstillstånd behöver du eller annan person som är ansvarig i företaget ha kunskap om ansvarsfull alkoholservering och alkohollagen. Denna kunskap kan du visa på flera sätt.</p>"
  },
  "knowledgeTestPassedBy": {
    "ui:order": [
      "personalIdentityNumber"
    ],
    "ui:options": {
      "showObjectFieldset": true
    },
    "personalIdentityNumber": {
      "ui:widget": "TextWidget",
      "ui:options": {
        "hideLabel": true
      }
    },
    "ui:description": "<p>Ange personnummer på den person i företaget som har genomfört och fått godkänt på Folkhälsomyndighetens kunskapsprov under de senaste 5 åren.</p>"
  },
  "otherLicensedBusiness": {
    "ui:order": [
      "organizationNumber"
    ],
    "ui:options": {
      "showObjectFieldset": true
    },
    "organizationNumber": {
      "ui:widget": "TextWidget",
      "ui:options": {
        "hideLabel": true
      }
    },
    "ui:description": "<p>Vilket företag med gällande serveringstillstånd driver du eller annan person som är ansvarig i företaget idag?<br />\nOm du eller annan företrädare för organisationen har ett serveringstillstånd idag som minst motsvarar den aktuella ansökan, och det inte finns skäl att ifrågasätta kunskaperna, kan det vara så att kunskaperna inte behöver styrkas med ett kunskapsprov.</p>"
  },
  "knowledgeTestRegistration": {
    "ui:widget": "RadiobuttonWidget",
    "ui:description": "<p>Om ditt ärende gäller en ansökan om stadigvarande serveringstillstånd så kan inte tillståndet beviljas innan minst en av de personer som du uppger här har genomfört och fått godkänt på kunskapsprovet.</p>"
  },
