{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stadigvarande serveringstillstånd",
  "type": "object",
  "properties": {
    "arDuFirmatecknare": {
      "type": "string",
      "oneOf": [
        {
          "const": "JA",
          "title": "Ja"
        },
        {
          "const": "NEJ",
          "title": "Nej"
        }
      ],
      "title": "Är du firmatecknare?"
    },
    "fakturaadressSammaSomForetaget": {
      "type": "string",
      "oneOf": [
        {
          "const": "JA",
          "title": "Ja"
        },
        {
          "const": "NEJ",
          "title": "Nej"
        }
      ],
      "title": "Är fakturaadressen samma som företagets adress?",
      "description": "Kommunen kan komma att ta ut en avgift. Om du vill att fakturan ska gå till den adress som företaget är registrerad på anger du \"Ja\" i fältet nedan. Om du vill att fakturan ska gå till en annan adress anger du \"Nej\" och fyller sedan i den. Du har även möjlighet att ange en fakturareferens."
    },
    "fakturamottagare": {
      "type": "object",
      "properties": {
        "cO": {
          "type": "string",
          "title": "c/o"
        },
        "utdelningsadress": {
          "type": "string",
          "title": "Utdelningsadress"
        },
        "postnummer": {
          "type": "string",
          "title": "Postnummer",
          "pattern": "^\\d{3}\\s?\\d{2}$"
        },
        "postort": {
          "type": "string",
          "title": "Postort"
        }
      },
      "required": [
        "utdelningsadress",
        "postnummer",
        "postort"
      ],
      "title": "Fakturamottagare"
    },
    "fakturareferens": {
      "type": "string",
      "title": "Fakturareferens",
      "description": "Ange här om du vill att fakturan ska ha någon specifik märkning, exempelvis ett namn eller nummer."
    },
    "verksamhetsbeskrivningsval": {
      "type": "string",
      "oneOf": [
        {
          "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I",
          "title": "Jag vill skriva verksamhetsbeskrivningen i formuläret"
        },
        {
          "const": "JAG_VILL_BIFOGA_VERKSAMHETSBESKRIVNINGEN_SOM",
          "title": "Jag vill bifoga verksamhetsbeskrivningen som fil"
        }
      ],
      "title": "Verksamhetsbeskrivning",
      "description": "Du måste lämna en detaljerad beskrivning av företagets verksamhet.\n\nHur vill du lämna verksamhetsbeskrivningen?"
    },
    "verksamhetsbeskrivning": {
      "type": "string",
      "title": "Verksamhetsbeskrivning"
    },
    "kunskapOmAlkohollagen": {
      "type": "string",
      "oneOf": [
        {
          "const": "HAR_GODKANT_KUNSKAPSPROV",
          "title": "Jag eller annan person som är ansvarig i företaget har genomfört och fått godkänt på Folkhälsomyndighetens kunskapsprov under de senaste 5 åren"
        },
        {
          "const": "DRIVER_ANNAT_FORETAG_MED_TILLSTAND",
          "title": "Jag eller annan person som är ansvarig i företaget driver annat företag med gällande serveringstillstånd idag"
        },
        {
          "const": "BEHOVER_SKRIVA_KUNSKAPSPROV",
          "title": "Jag eller annan person som är ansvarig i företaget behöver skriva kunskapsprovet"
        }
      ],
      "title": "Kunskap om alkohollagen",
      "description": "För att få ett serveringstillstånd behöver du eller annan person som är ansvarig i företaget ha kunskap om ansvarsfull alkoholservering och alkohollagen. Denna kunskap kan du visa på flera sätt."
    },
    "personnummer": {
      "type": "object",
      "properties": {
        "personnummer": {
          "type": "string",
          "title": "Personnummer",
          "pattern": "^(19|20)?\\d{6}[-+]?\\d{4}$"
        }
      },
      "title": "Personnummer",
      "description": "Ange personnummer på den person i företaget som har genomfört och fått godkänt på Folkhälsomyndighetens kunskapsprov under de senaste 5 åren."
    },
    "organisationsnummer": {
      "type": "object",
      "properties": {
        "organisationsnummer": {
          "type": "string",
          "title": "Organisationsnummer",
          "pattern": "^\\d{6}-?\\d{4}$"
        }
      },
      "title": "Organisationsnummer",
      "description": "Vilket företag med gällande serveringstillstånd driver du eller annan person som är ansvarig i företaget idag?\n\nOm du eller annan företrädare för organisationen har ett serveringstillstånd idag som minst motsvarar den aktuella ansökan, och det inte finns skäl att ifrågasätta kunskaperna, kan det vara så att kunskaperna inte behöver styrkas med ett kunskapsprov."
    },
    "anmalPersonerTillKunskapsprovet": {
      "type": "string",
      "oneOf": [
        {
          "const": "VILL_ANMALA_NU",
          "title": "Vill anmäla nu"
        },
        {
          "const": "VILL_ANMALA_SENARE",
          "title": "Vill anmäla senare"
        }
      ],
      "title": "Vill du anmäla personer i företaget till kunskapsprovet nu eller senare?",
      "description": "Om ditt ärende gäller en ansökan om stadigvarande serveringstillstånd så kan inte tillståndet beviljas innan minst en av de personer som du uppger här har genomfört och fått godkänt på kunskapsprovet."
    },
    "personerTillKunskapsprovet": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fornamn": {
            "type": "string",
            "title": "Förnamn"
          },
          "efternamn": {
            "type": "string",
            "title": "Efternamn"
          },
          "personnummer": {
            "type": "string",
            "title": "Personnummer"
          },
          "telefonnummer": {
            "type": "string",
            "title": "Telefonnummer"
          },
          "ePostadress": {
            "type": "string",
            "title": "E-postadress",
            "format": "email"
          }
        }
      },
      "title": "Härmed anmäler jag följande person/personer till att genomföra kunskapsprovet:"
    },
    "verksamhetensInriktning": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "oneOf": [
          {
            "const": "RESTAURANG",
            "title": "Restaurang"
          },
          {
            "const": "NATTKLUBB_DANS",
            "title": "Nattklubb/dans"
          },
          {
            "const": "SPEL_OBS_KRAVER_TILLSTAND_FRAN",
            "title": "Spel (OBS! Kräver tillstånd från Lotteriinspektionen)"
          },
          {
            "const": "UNDERHALLNING",
            "title": "Underhållning"
          },
          {
            "const": "HOTELL",
            "title": "Hotell"
          },
          {
            "const": "CATERING_TILL_SLUTNA_SALLSKAP",
            "title": "Catering till slutna sällskap"
          },
          {
            "const": "EVENEMANG",
            "title": "Evenemang"
          },
          {
            "const": "TRAFIKSERVERING_INRIKES_TRAFIK_PA_FARTYG",
            "title": "Trafikservering (inrikes trafik på fartyg, luftfartyg eller järnvägståg)"
          }
        ]
      },
      "title": "Verksamhetens inriktning",
      "description": "Här ska du ange vilken inriktning du har med din verksamhet. Du ska också förtydliga din inriktning genom att skriva in ytterligare information om verksamheten nedan. Det är ett underlag för kommunens bedömning av din tillståndsansökan. När det gäller den alkoholpolitiska prövningen kontaktar kommunen även andra instanser för deras synpunkter på verksamheten."
    },
    "harNi": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "oneOf": [
          {
            "const": "RUMSSERVERING",
            "title": "Rumsservering"
          },
          {
            "const": "MINIBAR",
            "title": "Minibar"
          }
        ]
      },
      "title": "Har ni:"
    },
    "beskrivVerksamhetensInriktning": {
      "type": "string",
      "title": "Beskriv verksamhetens inriktning",
      "description": "Här ska du med egna ord förtydliga inriktningen på din verksamhet.\n\nExempel på information som är viktig att ange är typ av restaurang, vilka öppettider som gäller, eventuella åldersgränser eller särskild \"profil\" på verksamheten (sportbar, live-musik etc). Ange även verksamhetens primära målgrupp."
    },
    "serveringTillAllmanhetenEllerSlutetSallskap": {
      "type": "string",
      "oneOf": [
        {
          "const": "ENBART_TILL_ALLMANHETEN",
          "title": "Enbart till allmänheten"
        },
        {
          "const": "ENBART_TILL_SLUTET_SALLSKAP",
          "title": "Enbart till slutet sällskap"
        },
        {
          "const": "BADE_TILL_ALLMANHETEN_OCH_TILL",
          "title": "Både till allmänheten och till slutet sällskap"
        }
      ],
      "title": "Ska servering av alkohol ske till allmänheten eller till slutet sällskap?"
    },
    "serveringsperiodForAllmanheten": {
      "type": "string",
      "oneOf": [
        {
          "const": "ARET_RUNT",
          "title": "Året runt"
        },
        {
          "const": "ARLIGEN_UNDER_VISS_PERIOD",
          "title": "Årligen under viss period"
        }
      ],
      "title": "Serveringsperiod för allmänheten"
    },
