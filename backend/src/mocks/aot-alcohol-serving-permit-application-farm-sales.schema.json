{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gårdsförsäljning",
  "type": "object",
  "properties": {
    "arDuFirmatecknare": {
      "type": "string",
      "oneOf": [
        {
          "const": "JA",
          "title": "Ja"
        },
        {
          "const": "NEJ",
          "title": "Nej"
        }
      ],
      "title": "Är du firmatecknare?"
    },
    "fakturaadressSammaSomForetaget": {
      "type": "string",
      "oneOf": [
        {
          "const": "JA",
          "title": "Ja"
        },
        {
          "const": "NEJ",
          "title": "Nej"
        }
      ],
      "title": "Är fakturaadressen samma som företagets adress?",
      "description": "Kommunen kan komma att ta ut en avgift. Om du vill att fakturan ska gå till den adress som företaget är registrerad på anger du \"Ja\" i fältet nedan. Om du vill att fakturan ska gå till en annan adress anger du \"Nej\" och fyller sedan i den. Du har även möjlighet att ange en fakturareferens."
    },
    "fakturamottagare": {
      "type": "object",
      "properties": {
        "cO": {
          "type": "string",
          "title": "c/o"
        },
        "utdelningsadress": {
          "type": "string",
          "title": "Utdelningsadress"
        },
        "postnummer": {
          "type": "string",
          "title": "Postnummer",
          "pattern": "^\\d{3}\\s?\\d{2}$"
        },
        "postort": {
          "type": "string",
          "title": "Postort"
        }
      },
      "required": [
        "utdelningsadress",
        "postnummer",
        "postort"
      ],
      "title": "Fakturamottagare"
    },
    "fakturareferens": {
      "type": "string",
      "title": "Fakturareferens",
      "description": "Ange här om du vill att fakturan ska ha någon specifik märkning, exempelvis ett namn eller nummer."
    },
    "verksamhetsbeskrivningsval": {
      "type": "string",
      "oneOf": [
        {
          "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I",
          "title": "Jag vill skriva verksamhetsbeskrivningen i formuläret"
        },
        {
          "const": "JAG_VILL_BIFOGA_VERKSAMHETSBESKRIVNINGEN_SOM",
          "title": "Jag vill bifoga verksamhetsbeskrivningen som fil"
        }
      ],
      "title": "Verksamhetsbeskrivning",
      "description": "Du måste lämna en detaljerad beskrivning av företagets verksamhet.\n\nHur vill du lämna verksamhetsbeskrivningen?"
    },
    "verksamhetsbeskrivning": {
      "type": "string",
      "title": "Verksamhetsbeskrivning"
    },
    "serveringsstalletsNamn": {
      "type": "string",
      "title": "Försäljningsställets namn"
    },
    "kontaktuppgifterTillServeringsstallet": {
      "type": "object",
      "properties": {
        "telefonnummer": {
          "type": "string",
          "title": "Telefonnummer"
        },
        "ePostadress": {
          "type": "string",
          "title": "E-postadress",
          "format": "email"
        }
      },
      "title": "Kontaktuppgifter till försäljningsstället"
    },
    "besoksadress": {
      "type": "object",
      "properties": {
        "gatuadress": {
          "type": "string",
          "title": "Gatuadress"
        },
        "postnummer": {
          "type": "string",
          "title": "Postnummer",
          "pattern": "^\\d{3}\\s?\\d{2}$"
        },
        "postort": {
          "type": "string",
          "title": "Postort"
        }
      },
      "required": [
        "gatuadress",
        "postnummer",
        "postort"
      ],
      "title": "Försäljningsställets besöksadress"
    },
    "alkoholdrycker": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "oneOf": [
          {
            "const": "STARKOL",
            "title": "Starköl"
          },
          {
            "const": "VIN",
            "title": "Vin"
          },
          {
            "const": "SPRITDRYCKER",
            "title": "Spritdrycker"
          },
          {
            "const": "CIDER_ELLER_ANDRA_JASTA_ALKOHOLDRYCKER",
            "title": "Cider eller andra jästa alkoholdrycker"
          }
        ]
      },
      "title": "Alkoholdrycker"
    },
    "literStarkol": {
      "type": "string",
      "title": "Hur många liter starköl tillverkas?",
      "description": "Förra kalenderåret, eller uppskattad volym om produktionen är nystartad. Ange antal liter i siffror.",
      "pattern": "^\\d+$"
    },
    "literVin": {
      "type": "string",
      "title": "Hur många liter vin tillverkas?",
      "description": "Förra kalenderåret, eller uppskattad volym om produktionen är nystartad. Ange antal liter i siffror.",
      "pattern": "^\\d+$"
    },
    "literSpritdrycker": {
      "type": "string",
      "title": "Hur många liter spritdrycker tillverkas?",
      "description": "Förra kalenderåret, eller uppskattad volym om produktionen är nystartad. Ange antal liter i siffror.",
      "pattern": "^\\d+$"
    },
    "literCider": {
      "type": "string",
      "title": "Hur många liter cider eller andra jästa alkoholdrycker tillverkas?",
      "description": "Förra kalenderåret, eller uppskattad volym om produktionen är nystartad. Ange antal liter i siffror.",
      "pattern": "^\\d+$"
    },
    "produktionenStartade": {
      "type": "string",
      "format": "date",
      "title": "När startade produktionen?"
    },
    "beroendeTillAnnanTillverkare": {
      "type": "string",
      "oneOf": [
        {
          "const": "JA",
          "title": "Ja"
        },
        {
          "const": "NEJ",
          "title": "Nej"
        }
      ],
      "title": "Finns det något beroende till en annan alkoholdryckestillverkare?",
      "description": "Till exempel tillverkning på licens, sponsring, gemensamma ägare eller ledamöter eller gemensamma transporter."
    },
    "beskrivBeroende": {
      "type": "string",
      "title": "Beskriv beroendet"
    },
    "produktionsbeskrivningsval": {
      "type": "string",
      "oneOf": [
        {
          "const": "JAG_VILL_BESKRIVA",
          "title": "Jag vill beskriva produktionen i formuläret"
        },
        {
          "const": "JAG_VILL_LADDA_UPP",
          "title": "Jag vill bifoga produktionsbeskrivningen som fil"
        }
      ],
      "title": "Produktionsbeskrivning"
    },
    "produktionsbeskrivning": {
      "type": "string",
      "title": "Beskriv produktionen"
    },
    "forsaljningsperiod": {
      "type": "string",
      "oneOf": [
        {
          "const": "ARET_RUNT",
          "title": "Året runt"
        },
        {
          "const": "ARLIGEN_UNDER_VISS_PERIOD",
          "title": "Årligen under viss period"
        }
      ],
      "title": "Försäljningsperiod"
    },
    "angePeriodForForsaljning": {
      "type": "object",
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date",
          "title": "Från och med"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "title": "Till och med"
        }
      },
      "required": [
        "startDate",
        "endDate"
      ],
      "title": "Ange period för försäljning"
    },
    "forsaljningstider": {
      "type": "object",
      "properties": {
        "startTime": {
          "type": "string",
          "format": "time",
          "title": "Från klockan"
        },
        "endTime": {
          "type": "string",
          "format": "time",
          "title": "Till klockan"
        }
      },
      "required": [
        "startTime",
        "endTime"
      ],
      "title": "Försäljningstider"
    },
    "besoksarrangemang": {
      "type": "string",
      "oneOf": [
        {
          "const": "JAG_VILL_BESKRIVA_BESOKSARRANGEMANGET",
          "title": "Jag vill beskriva besöksarrangemanget"
        },
        {
          "const": "JAG_VILL_LADDA_UPP_BESKRIVNING",
          "title": "Jag vill ladda upp beskrivning på besöksarrangemanget"
        }
      ],
      "title": "Besöksarrangemang"
    },
    "beskrivBesoksarrangemanget": {
      "type": "string",
      "title": "Beskriv besöksarrangemanget"
    },
    "beskrivForsaljningsplats": {
      "type": "string",
      "title": "Beskriv försäljningsplats"
    },
    "kunskapOmAlkohollagen": {
      "type": "string",
      "oneOf": [
        {
          "const": "HAR_GODKANT_KUNSKAPSPROV",
          "title": "Jag eller annan person som är ansvarig i företaget har genomfört och fått godkänt på Folkhälsomyndighetens kunskapsprov under de senaste 5 åren"
        },
        {
          "const": "DRIVER_ANNAT_FORETAG_MED_TILLSTAND",
          "title": "[TEXT SAKNAS: anpassas till gårdsförsäljning] Jag eller annan person som är ansvarig i företaget driver annat företag med gällande serveringstillstånd idag"
        },
        {
          "const": "BEHOVER_SKRIVA_KUNSKAPSPROV",
          "title": "Jag eller annan person som är ansvarig i företaget behöver skriva kunskapsprovet"
        }
      ],
      "title": "Kunskap om alkohollagen",
      "description": "[TEXT SAKNAS: anpassas till gårdsförsäljning] För att få ett serveringstillstånd behöver du eller annan person som är ansvarig i företaget ha kunskap om ansvarsfull alkoholservering och alkohollagen. Denna kunskap kan du visa på flera sätt."
    },
    "personnummer": {
      "type": "object",
      "properties": {
        "personnummer": {
          "type": "string",
          "title": "Personnummer",
          "pattern": "^(19|20)?\\d{6}[-+]?\\d{4}$"
        }
      },
      "title": "Personnummer",
      "description": "Ange personnummer på den person i företaget som har genomfört och fått godkänt på Folkhälsomyndighetens kunskapsprov under de senaste 5 åren."
    },
    "organisationsnummer": {
      "type": "object",
      "properties": {
        "organisationsnummer": {
          "type": "string",
          "title": "Organisationsnummer",
          "pattern": "^\\d{6}-?\\d{4}$"
        }
      },
      "title": "Organisationsnummer",
      "description": "[TEXT SAKNAS: anpassas till gårdsförsäljning] Vilket företag med gällande serveringstillstånd driver du eller annan person som är ansvarig i företaget idag?\n\nOm du eller annan företrädare för organisationen har ett serveringstillstånd idag som minst motsvarar den aktuella ansökan, och det inte finns skäl att ifrågasätta kunskaperna, kan det vara så att kunskaperna inte behöver styrkas med ett kunskapsprov."
    },
    "anmalPersonerTillKunskapsprovet": {
      "type": "string",
      "oneOf": [
        {
          "const": "VILL_ANMALA_NU",
          "title": "Vill anmäla nu"
        },
        {
          "const": "VILL_ANMALA_SENARE",
          "title": "Vill anmäla senare"
        }
      ],
      "title": "Vill du anmäla personer i företaget till kunskapsprovet nu eller senare?",
      "description": "[TEXT SAKNAS: anpassas till gårdsförsäljning] Om ditt ärende gäller en ansökan om stadigvarande serveringstillstånd så kan inte tillståndet beviljas innan minst en av de personer som du uppger här har genomfört och fått godkänt på kunskapsprovet."
    },
    "personerTillKunskapsprovet": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fornamn": {
            "type": "string",
            "title": "Förnamn"
          },
          "efternamn": {
            "type": "string",
            "title": "Efternamn"
          },
          "personnummer": {
            "type": "string",
            "title": "Personnummer"
          },
          "telefonnummer": {
            "type": "string",
            "title": "Telefonnummer"
          },
          "ePostadress": {
            "type": "string",
            "title": "E-postadress",
            "format": "email"
          }
        }
      },
      "title": "Härmed anmäler jag följande person/personer till att genomföra kunskapsprovet:"
    },
    "serveringsansvarigPersonal": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fornamn": {
            "type": "string",
            "title": "Förnamn"
          },
          "efternamn": {
            "type": "string",
            "title": "Efternamn"
          },
          "fodelsedatum": {
            "type": "string",
            "format": "date",
            "title": "Födelsedatum"
          },
          "fromDate": {
            "type": "string",
            "format": "date",
            "title": "Från och med"
          }
        },
        "required": [
          "fornamn",
          "efternamn",
          "fodelsedatum",
          "fromDate"
        ]
      },
      "title": "Ange försäljningsansvariga",
      "description": "[TEXT SAKNAS: anpassas till gårdsförsäljning] Under öppettider måste det alltid finnas en serveringsansvarig person på plats i verksamheten. Om inte någon av företagets företrädare är på plats måste en annan utsedd och anmäld serveringsansvarig vara på plats. Nedan anger du namn och födelsedatum till den person eller de personer som är ansvariga för servering av alkohol. En person som är serveringsansvarig måste vara minst 20 år.\n\nHar du inte anställt personal ännu kan du fylla i serveringsansvarig personal vid ett senare tillfälle."
    },
    "finansiering": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "oneOf": [
          {
            "const": "EGNA_MEDEL",
            "title": "Egna medel"
          },
          {
            "const": "BANKLAN",
            "title": "Banklån"
          },
          {
            "const": "PRIVATLAN",
            "title": "Privatlån"
          },
          {
            "const": "ANNAN_FINANSIERING_EXEMPELVIS_ALMILAN_BRYGGERILAN",
            "title": "Annan finansiering (exempelvis Almilån, Bryggerilån eller Revers)"
          }
        ]
      },
      "title": "Finansiering",
      "description": "För att så långt det är möjligt säkerställa att restaurangbranschens präglas av sund konkurrens på lika villkor prövas finansieringen av verksamheten när du ansöker om serveringstillstånd. Du måste därför visa hur köpet och investeringar i verksamheten är finansierade samt hur första årets drift av verksamheten är finansierad. Verksamheten kan till exempel vara finansierad med banklån eller privatlån (lån från privatpersoner) och egna sparade medel. Du visar hur verksamheten är finansierad genom att bifoga lånehandlingar från långivaren eller genom kontoutdrag som visar att du sparat ihop till de pengar som du finansierar verksamheten med."
    },
    "egnaMedel": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bank": {
            "type": "string",
            "title": "Bank"
          },
          "kontonummer": {
            "type": "string",
            "title": "Kontonummer"
          },
          "beloppKronor": {
            "type": "string",
            "title": "Belopp (kronor)"
          }
        },
        "required": [
          "bank",
          "kontonummer",
          "beloppKronor"
        ]
      },
      "title": "Egna medel"
    },
    "banklan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "langivare": {
            "type": "string",
            "title": "Långivare"
          },
          "beloppKronor": {
            "type": "string",
            "title": "Belopp (kronor)"
          }
        },
        "required": [
          "langivare",
          "beloppKronor"
        ]
      },
      "title": "Banklån"
    },
    "privatlan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "langivare": {
            "type": "string",
            "title": "Långivare"
          },
          "beloppKronor": {
            "type": "string",
            "title": "Belopp (kronor)"
          }
        },
        "required": [
          "langivare",
          "beloppKronor"
        ]
      },
      "title": "Privatlån"
    },
    "annanFinansiering": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lanetyp": {
            "type": "string",
            "title": "Lånetyp"
          },
          "langivare": {
            "type": "string",
            "title": "Långivare"
          },
          "beloppKronor": {
            "type": "string",
            "title": "Belopp (kronor)"
          }
        },
        "required": [
          "lanetyp",
          "langivare",
          "beloppKronor"
        ]
      },
      "title": "Annan finansiering"
    },
    "ovrigaUpplysningarFinansiering": {
      "type": "string",
      "title": "Övriga upplysningar angående finansieringen"
    }
  },
  "required": [
    "arDuFirmatecknare",
    "verksamhetsbeskrivningsval",
    "fakturaadressSammaSomForetaget",
    "serveringsstalletsNamn",
    "besoksadress",
    "alkoholdrycker",
    "produktionenStartade",
    "beroendeTillAnnanTillverkare",
    "produktionsbeskrivningsval",
    "forsaljningsperiod",
    "forsaljningstider",
    "besoksarrangemang",
    "kunskapOmAlkohollagen",
    "finansiering"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "fakturaadressSammaSomForetaget": {
            "const": "NEJ"
          }
        },
        "required": [
          "fakturaadressSammaSomForetaget"
        ]
      },
      "then": {
        "properties": {
          "fakturamottagare": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "verksamhetsbeskrivningsval": {
            "const": "JAG_VILL_SKRIVA_VERKSAMHETSBESKRIVNINGEN_I"
          }
        },
        "required": [
          "verksamhetsbeskrivningsval"
        ]
      },
      "then": {
        "required": [
          "verksamhetsbeskrivning"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "forsaljningsperiod": {
            "const": "ARLIGEN_UNDER_VISS_PERIOD"
          }
        },
        "required": [
          "forsaljningsperiod"
        ]
      },
      "then": {
        "properties": {
          "angePeriodForForsaljning": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "besoksarrangemang": {
            "const": "JAG_VILL_BESKRIVA_BESOKSARRANGEMANGET"
          }
        },
        "required": [
          "besoksarrangemang"
        ]
      },
      "then": {
        "required": [
          "beskrivBesoksarrangemanget"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "alkoholdrycker": {
            "contains": {
              "const": "STARKOL"
            }
          }
        },
        "required": [
          "alkoholdrycker"
        ]
      },
      "then": {
        "required": [
          "literStarkol"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "alkoholdrycker": {
            "contains": {
              "const": "VIN"
            }
          }
        },
        "required": [
          "alkoholdrycker"
        ]
      },
      "then": {
        "required": [
          "literVin"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "alkoholdrycker": {
            "contains": {
              "const": "SPRITDRYCKER"
            }
          }
        },
        "required": [
          "alkoholdrycker"
        ]
      },
      "then": {
        "required": [
          "literSpritdrycker"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "alkoholdrycker": {
            "contains": {
              "const": "CIDER_ELLER_ANDRA_JASTA_ALKOHOLDRYCKER"
            }
          }
        },
        "required": [
          "alkoholdrycker"
        ]
      },
      "then": {
        "required": [
          "literCider"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "beroendeTillAnnanTillverkare": {
            "const": "JA"
          }
        },
        "required": [
          "beroendeTillAnnanTillverkare"
        ]
      },
      "then": {
        "required": [
          "beskrivBeroende"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "produktionsbeskrivningsval": {
            "const": "JAG_VILL_BESKRIVA"
          }
        },
        "required": [
          "produktionsbeskrivningsval"
        ]
      },
      "then": {
        "required": [
          "produktionsbeskrivning"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kunskapOmAlkohollagen": {
            "const": "HAR_GODKANT_KUNSKAPSPROV"
          }
        },
        "required": [
          "kunskapOmAlkohollagen"
        ]
      },
      "then": {
        "required": [
          "personnummer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kunskapOmAlkohollagen": {
            "const": "DRIVER_ANNAT_FORETAG_MED_TILLSTAND"
          }
        },
        "required": [
          "kunskapOmAlkohollagen"
        ]
      },
      "then": {
        "required": [
          "organisationsnummer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kunskapOmAlkohollagen": {
            "const": "BEHOVER_SKRIVA_KUNSKAPSPROV"
          }
        },
        "required": [
          "kunskapOmAlkohollagen"
        ]
      },
      "then": {
        "required": [
          "anmalPersonerTillKunskapsprovet"
        ]
      }
    },
    {
      "if": {
        "properties": {
