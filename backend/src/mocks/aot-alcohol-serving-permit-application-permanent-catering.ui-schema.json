  "kunskapOmAlkohollagen": {
    "ui:widget": "RadiobuttonWidget",
    "ui:description": "<p>För att få ett cateringtillstånd behöver du eller annan person som är ansvarig i företaget ha kunskap om ansvarsfull alkoholservering och alkohollagen. Denna kunskap kan du visa på flera sätt.</p>"
  },
  "personnummer": {
    "ui:order": [
      "personnummer"
    ],
    "ui:options": {
      "showObjectFieldset": true
    },
    "personnummer": {
      "ui:widget": "TextWidget",
      "ui:options": {
        "hideLabel": true
      }
    },
    "ui:description": "<p>Ange personnummer på den person i företaget som har genomfört och fått godkänt på Folkhälsomyndighetens kunskapsprov under de senaste 5 åren.</p>"
  },
  "organisationsnummer": {
    "ui:order": [
      "organisationsnummer"
    ],
    "ui:options": {
      "showObjectFieldset": true
    },
    "organisationsnummer": {
      "ui:widget": "TextWidget",
      "ui:options": {
        "hideLabel": true
      }
    },
    "ui:description": "<p>Vilket företag med gällande serveringstillstånd driver du eller annan person som är ansvarig i företaget idag?<br />\nOm du eller annan företrädare för organisationen har ett serveringstillstånd idag som minst motsvarar den aktuella ansökan, och det inte finns skäl att ifrågasätta kunskaperna, kan det vara så att kunskaperna inte behöver styrkas med ett kunskapsprov.</p>"
  },
  "anmalPersonerTillKunskapsprovet": {
    "ui:widget": "RadiobuttonWidget",
    "ui:description": "<p>Om ditt ärende gäller en ansökan om stadigvarande cateringtillstånd så kan inte tillståndet beviljas innan minst en av de personer som du uppger här har genomfört och fått godkänt på kunskapsprovet.</p>"
  },
