{
  "name": "@sk-web-gui/web-app-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <=24"
  },
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "dotenv -e .env -- next dev",
    "prebuild": "yarn generate:middleware-envs",
    "build": "dotenv -e .env -- next build",
    "build:webpack": "dotenv -e .env -- next build --webpack",
    "prebuild:test": "yarn generate:middleware-envs",
    "build:test": "dotenv -e .env -- cross-env TEST=true next build",
    "start": "next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development tsx ./src/generate-contracts.ts",
    "prelint": "yarn generate:middleware-envs",
    "lint": "eslint src/ e2e/ tests/",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "dotenv -e .env -- cross-env TEST=true playwright test",
    "e2e:ui": "dotenv -e .env -- cross-env TEST=true playwright test --ui",
    "pretype-check": "yarn generate:middleware-envs",
    "type-check": "tsc --pretty --noEmit && tsc --project tests/tsconfig.json --pretty --noEmit && tsc --project e2e/tsconfig.json --pretty --noEmit",
    "prelint:fix": "yarn generate:middleware-envs",
    "lint:fix": "eslint src/ e2e/ tests/ --fix",
    "prelint:strict": "yarn generate:middleware-envs",
    "lint:strict": "eslint src/ e2e/ tests/ --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write \"{src,e2e,tests}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,e2e,tests}/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "@sk-web-gui/alert": "^1.1.2",
    "@sk-web-gui/core": "4.6.1",
    "@sk-web-gui/react": "3.1.2",
    "@sk-web-gui/text-editor": "^2.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.19",
    "dotenv-cli": "^11.0.0",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.1",
    "lodash": "4.18.1",
    "lucide-react": "1.31.0",
    "next": "16.1.6",
    "next-i18n-router": "^5.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^17.0.11",
    "sanitize-html": "^2.17.0",
    "sass": "^1.97.3",
    "sharp": "^0.35.3",
    "yup": "^1.7.1",
    "zustand": "^5.0.11"
  },
  "resolutions": {
    "form-data": "^4.0.4",
    "@rjsf/validator-ajv8/ajv": "8.20.0",
    "typescript-eslint": "8.67.0",
    "vitest/vite": "8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.11.0",
    "@types/underscore.string": "^0.0.42",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "swagger-typescript-api": "^13.12.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
