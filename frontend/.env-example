NEXT_PUBLIC_APP_NAME=Katla
# LOCAL, TEST eller tomt för produktion. Styr testmiljöhjälp i gränssnittet.
NEXT_PUBLIC_ENVIRONMENT=
# Full API-rot inklusive backendens BASE_URL_PREFIX.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Valfri. Serverside-anrop (proxy.ts, /api/health/up) går hit i stället för via den publika adressen,
# t.ex. http://localhost:3001/api när backend kör på samma värd. Tom = NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
DOMAIN_NAME=localhost
NEXT_PUBLIC_BASE_PATH=''
ADMIN_URL=http://localhost:3002/
# Måste matcha SESSION_COOKIE_NAME i backend, annars ser proxy.ts aldrig sessionen.
NEXT_PUBLIC_SESSION_COOKIE_NAME=connect.sid
# Utan basePath och språkprefix. Prefixmatchas, så /alkoholtillstand täcker /alkoholtillstand/arende/AOT-1/...
# Lämna tom lokalt för att kunna köra Playwright — se Testing i CLAUDE.md. Då sker ingen
# omdirigering till /login; gå dit manuellt i stället.
NEXT_PUBLIC_PROTECTED_ROUTES="/alkoholtillstand"
HEALTH_AUTH=false
HEALTH_USERNAME=''
HEALTH_PASSWORD=''
# Session Inactivity Warning Configuration
# Both variables must be set to enable inactivity monitoring
# Values are in milliseconds

# Time of user inactivity before showing warning dialog
NEXT_PUBLIC_INACTIVITY_WARNING_TIMEOUT=1500000

# Countdown time shown in warning dialog before auto-logout
NEXT_PUBLIC_INACTIVITY_COUNTDOWN_TIMEOUT=300000


# Feature flag: Enable draft errand functionality (save with lifecycle DRAFT)
NEXT_PUBLIC_DRAFT_ERRAND=false
NEXT_PUBLIC_REDUCED_STAKEHOLDER_INFO=true
NEXT_PUBLIC_ERRAND_FILTER=true
NEXT_PUBLIC_OTHER_PARTIES_DISCLOSURE=false
